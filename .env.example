# ===================================================
# MoodMentor - AI Emotion Journal Configuration
# ===================================================

# Application Security
SECRET_KEY=moodmentor-secret-key-change-in-production-2026
JWT_SECRET_KEY=moodmentor-jwt-super-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moodmentor_db

# SQLite Fallback (Auto-enables if MySQL connection fails)
USE_SQLITE_FALLBACK=True

# Backend Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Frontend Server
API_BASE_URL=http://localhost:5000/api
STREAMLIT_PORT=8501

# AI Model Configuration
HF_EMOTION_MODEL=bhadresh-savani/distilbert-base-uncased-emotion
